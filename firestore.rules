rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSuperAdmin() {
      return request.auth != null && 
        (
          (exists(/databases/$(database)/documents/system_users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.role == 'superadmin') ||
          request.auth.token.email == 'admin@mahinsaas.com'
        );
    }

    function isTenantAdmin(tenantId) {
      return request.auth != null && 
        (
          isSuperAdmin() ||
          (exists(/databases/$(database)/documents/system_users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.tenantId == tenantId) ||
          (exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
           get(/databases/$(database)/documents/tenants/$(tenantId)).data.email == request.auth.token.email) ||
          (exists(/databases/$(database)/documents/tenants/$(tenantId)/settings/general) &&
           get(/databases/$(database)/documents/tenants/$(tenantId)/settings/general).data.email == request.auth.token.email)
        );
    }

    // Platform Landing Page Settings & Leads
    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // System Users: Allow users to read and update their own profile, SuperAdmin has full access
    match /system_users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if request.auth != null && (
        isSuperAdmin() || 
        (request.auth.uid == userId && request.resource.data.role != 'superadmin')
      );
      allow delete: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Store public data is readable by all (needed for storefronts and checkout)
      allow read: if true;
      allow write: if isSuperAdmin();

      match /settings/{docId} {
        allow read: if docId == 'general' || docId == 'homepage_layout' || docId == 'footer' || isTenantAdmin(tenantId);
        allow update: if isTenantAdmin(tenantId) && docId != 'general';
        allow create, delete: if isSuperAdmin();
        allow update: if isSuperAdmin();
      }
      match /products/{productId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }
      match /orders/{orderId} {
        allow create: if true;
        allow read, update, delete: if isTenantAdmin(tenantId);
      }
      match /quotations/{quoteId} {
        allow create: if true;
        allow read, update, delete: if isTenantAdmin(tenantId);
      }
    }
  }
}
